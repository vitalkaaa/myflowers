# Скопируйте в .env и заполните. Сам .env в git не коммитить.

# Вход на сайт. admin/admin — только для локального старта! Для доступа из интернета —
# длинный случайный пароль: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
APP_USERNAME=admin
APP_PASSWORD=admin
# Ключ подписи cookie: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true, только если сайт открывается по HTTPS; при доступе по http://IP — false
COOKIE_SECURE=false

# Telegram: токен от @BotFather; chat id канала вида -100… (бот должен быть админом канала)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если Telegram доступен только через прокси: http://, https://, socks5:// или socks5h://
# прокси на этом компьютере из контейнера доступен как host.docker.internal, например socks5://host.docker.internal:1080
TELEGRAM_PROXY=
# Время рассылки (cron: минута час день месяц день_недели)
REMINDER_CRON=0 19 * * *
TZ_NAME=Europe/Moscow
# Адрес сайта для ссылок на карточки в сообщениях (необязательно)
BASE_URL=

# Резервная копия БД (с фото) в data/backups/ — каждую ночь, хранятся последние BACKUP_KEEP штук
BACKUP_CRON=30 3 * * *
BACKUP_KEEP=14

# Где слушает сайт. Локально: 127.0.0.1 и 8080 → http://localhost:8080
# На сервере для доступа из интернета: WEB_BIND=0.0.0.0 и WEB_PORT=80 → http://<IP сервера>
WEB_BIND=127.0.0.1
WEB_PORT=8080
